{
  "name": "clearframe",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Highlights authorial choices with neutral alternatives.",
  "scripts": {
    "build": "node build.js",
    "test": "node tests/run.js",
    "typecheck": "tsc --noEmit",
    "ci": "npm run build && npm run size:check && npm run typecheck && npm test",
    "size:check": "node tools/check-size.js",
    "data:download": "node tools/download-data.js",
    "data:download:evaluation": "node tools/download-data.js --include-evaluation babe",
    "mine:wnc": "node tools/mine-wnc.js",
    "mine:gst": "node tools/mine-gst.js",
    "data:crec": "node tools/download-crec.js",
    "mine:crec": "node tools/mine-crec.js",
    "rules:magpie": "node tools/generate-magpie-rules.js",
    "data:normalize": "node tools/normalize-priority-data.js",
    "evaluate:babe": "node tools/evaluate-babe.js",
    "evaluate:context": "node tools/evaluate-context-sanity.js",
    "evaluate:balance": "node tools/evaluate-balance.js",
    "bench": "node tools/benchmark-matcher.js",
    "bench:browsers": "node tools/browser-benchmark.js",
    "profile:browsers": "node tools/profile-extension.js",
    "smoke:sites": "node tools/browser-smoke.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
