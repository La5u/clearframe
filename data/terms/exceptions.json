{
  "terms": {
    "act": { "unless": [{ "after": "/^\\s+(?:one|two|three|[IVX]+|\\d+)\\b/u" }] },
    "ask": { "unless": [{ "after": "/^(?:\\.com\\b|\\s+(?:Amy|Abby|Ann|Polly)\\b)/u" }] },
    "breaking": {
      "note": "Only a \"BREAKING:\" / \"breaking news\" label, or a text that opens with the word; not \"breaking the law\" or \"record-breaking\".",
      "unless": [
        { "before": "/\\S/u", "after": "/^(?!\\s*(?::|news\\b|update|story))/iu" }
      ]
    },
    "buy": { "unless": [{ "after": "/^\\s+(?:orders?|ratings?|recommendations?|signals?)\\b/iu" }] },
    "click": { "unless": [{ "after": "/^\\s+(?:fraud|rates?|counts?|bait)\\b/iu" }] },
    "come": {
      "note": "A named subject after the idiomatic kicker (Come clean Hilary Duff), or a concessive idiom; keep commands such as Come clean about it.",
      "unless": [{ "after": "/^\\s+(?:clean\\s+\\p{Lu}|rain\\s+or\\s+shine\\b|hell\\s+or\\s+high\\s+water\\b|what\\s+may\\b)/u" }]
    },
    "discover": { "unless": [{ "after": "/^\\s+(?:card|bank|financial\\s+services)\\b/iu" }] },
    "download": { "unless": [{ "after": "/^\\s+(?:speeds?|limits?|sizes?|rates?|counts?)\\b/iu" }] },
    "elite": { "unless": ["productName"] },
    "evil": {
      "note": "Titles, in Title Case or capitals: \"Resident Evil\", \"EVIL DEAD\"; not \"a resident evil plot\".",
      "unless": [
        { "match": "/^(?:Evil|EVIL)$/u", "before": "/\\b(?:Resident|RESIDENT)\\s+$/u" },
        { "match": "/^(?:Evil|EVIL)$/u", "after": "/^\\s*(?:Dead|DEAD)\\b/u" }
      ]
    },
    "exclusive": {
      "note": "\"EXCLUSIVE\" badges are clickbait; an \"exclusive license\" in body text is not.",
      "unless": [
        { "headline": false, "match": "/\\p{Changes_When_Uppercased}/u" }
      ]
    },
    "far-left": { "unless": ["position"] },
    "far-right": { "unless": ["position"] },
    "find": { "unless": [{ "after": "/^\\s+spots?\\b/iu" }] },
    "follow": { "unless": [{ "after": "/^\\s+up\\s+(?:appointments?|visits?|studies|questions?)\\b/iu" }] },
    "get": { "unless": [{ "after": "/^\\s+out\\s+of\\s+jail\\s+(?:free\\s+)?cards?\\b/iu" }] },
    "give": { "unless": [{ "after": "/^\\s+and\\s+take\\b/iu" }] },
    "grab": { "unless": [{ "after": "/^\\s+bags?\\b/iu" }] },
    "horror": {
      "note": "The genre: \"horror movies\", \"sci-fi and horror\", \"psycho-horror\".",
      "unless": [
        { "after": "/^\\s+(?:movies?|films?|genre|fans?|franchise|flicks?|novels?|stor(?:y|ies)|series|classics?|writers?|directors?|games?)\\b/iu" },
        { "before": "/(?:-|\\bsci-fi and\\s)$/iu" }
      ]
    },
    "iconic": { "unless": ["productName"] },
    "imagine": { "unless": [{ "after": "/^\\s+Dragons\\b/u" }] },
    "join": { "unless": [{ "after": "/^\\s+(?:operations?|conditions?|clauses?)\\b/iu" }] },
    "keep": { "unless": [{ "after": "/^\\s+net\\b/iu" }] },
    "legendary": { "unless": ["productName"] },
    "look": { "unless": [{ "after": "/^\\s+(?:books?|alikes?)\\b/iu" }] },
    "meet": {
      "unless": [{ "after": "/^\\s+(?:the\\s+press|records?|results?)\\b/iu" }]
    },
    "miracle": {
      "note": "Brands use the noun (\"Miracle-Gro\", \"Miracle Recovery cream\"); a capitalised \"Miraculous\" is a sentence start or a Title Case headline, so the product guard skips that alias.",
      "unless": [
        { "match": "/^(?:Miracle|MIRACLE)\\b/u", "nearby": "/\\b(?:xbox|playstation|pixel|iphone|galaxy|controller|gamepad|keyboard|mouse|laptop|phone|model|series|edition|package|trim|brand|product|album|film|show|team|unit|magazine|newspaper|records|studios)\\b/iu" },
        { "match": "/^(?:Miracle|MIRACLE)\\b/u", "textBefore": "/\\b[A-Z][\\p{L}\\d-]+\\s+$/u" }
      ]
    },
    "must": {
      "note": "\"must-have\" and \"must-see\" are hype; \"a must\" is a noun.",
      "unless": [
        { "after": "/^-/u" },
        { "before": "/\\b(?:a|an|the|real|total)\\s+$/iu" }
      ]
    },
    "need to": {
      "note": "\"the need to protect\" is a noun; only the verb is a modal.",
      "unless": [{ "before": "/\\b(?:the|a|an|their|his|her|its|our|your|my)\\s+$/iu" }]
    },
    "picture": { "unless": [{ "after": "/^\\s+(?:frames?|credits?|captions?|quality|books?|postcards?)\\b/iu" }] },
    "plunge": {
      "note": "Clothing (\"plunging neckline\") and literal falls into water or through the air.",
      "unless": [
        { "match": "/^plunging$/iu", "after": "/^\\s+(?:[\\p{L}-]+\\s+){0,3}(?:neckline|bikini|swimsuit|dress|gown|top|bra|corset|bodysuit|outfit|number|blouse|jumpsuit|frock)\\b/iu" },
        { "after": "/^\\s+(?:underwater|through the atmosphere|into (?:the |a )?(?:water|sea|river|lake|pool|ocean))\\b/iu" }
      ]
    },
    "revolutionary": {
      "unless": [
        { "after": "/^\\s*(?:guards?|war|army|front|committee|party)\\b/iu" }
      ]
    },
    "sacked": {
      "note": "American football: a quarterback \"sacked eight times\" or \"sacked for a loss\"; not a firm that \"sacked 300 staff\".",
      "unless": [
        { "after": "/^\\s*(?:(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten)\\s+(?:more\\s+)?times\\b|for\\s+(?:a\\s+)?(?:loss|safety|\\d))/iu" },
        { "before": "/\\b(?:quarterback|qb|was|got|been)\\s+$/iu", "after": "/\\b(?:times|loss|yards?|sacks?)\\b/iu" }
      ]
    },
    "secret": {
      "unless": [
        { "after": "/^\\s*service\\b/iu" }
      ]
    },
    "see": { "unless": [{ "after": "/^\\s+all\\s+(?:columnists|authors|contributors|articles|stories|results|comments)\\s*$/iu" }] },
    "severe": {
      "unless": [
        { "after": "/^\\s*(?:(?:storms?|thunderstorms?|weather|drought|flooding|turbulence|winds?)\\b|allerg)/iu" }
      ]
    },
    "shock": {
      "unless": [
        { "before": "/\\b(?:electric|economic|price|oil|supply|culture|toxic|septic|anaphylactic|shell)\\s+$/iu" },
        { "after": "/^\\s*(?:gloves?|therapy|absorbers?|wave|collars?)\\b/iu" }
      ]
    },
    "spot": { "unless": [{ "after": "/^\\s+(?:prices?|markets?|rates?|welds?|checks?)\\b/iu" }] },
    "start": { "unless": [{ "after": "/^\\s+(?:dates?|times?|lines?|menus?|buttons?)\\b/iu" }] },
    "stay": { "unless": [{ "after": "/^\\s+orders?\\b/iu" }] },
    "superstar": { "unless": ["productName"] },
    "take": { "unless": [{ "after": "/^\\s+home\\s+pay\\b/iu" }] },
    "tell": { "unless": [{ "after": "/^\\s+tale\\s+signs?\\b/iu" }] },
    "think": {
      "unless": [{ "after": "/^\\s+tanks?\\b/iu" }]
    },
    "try": { "unless": [{ "after": "/^\\s+(?:lines?|scorers?|scoring)\\b/iu" }] },
    "under fire": {
      "note": "Only the literal sense: forces or vessels under fire, fire from armed attackers or weapons, or a combat context. \"Came under fire from critics\" is what the rule is for.",
      "unless": [
        { "before": "/\\b(?:troops|soldiers?|convoys?|patrols?|marines|peacekeepers|warships?|ships?|vessels?|tankers?|helicopters?|aircraft|positions|bases?)\\s+(?:(?:came|come|comes|coming|were|was|are|is|had|has|have|been|got|reportedly)\\s+)*$/iu" },
        { "after": "/^\\s*from\\s+(?:[\\w'’-]+\\s+){0,2}(?:gunmen|snipers?|rebels|militants?|insurgents|militia(?:s|men)?|fighters|terrorists|jihadists|troops|soldiers|forces|army|artillery|rockets?|missiles?|mortars?|drones?|tanks?|warships?|enemy)\\b/iu" },
        { "nearby": "/\\b(?:gunfire|gunmen|shots were fired|shelling|snipers?|artillery|ambush(?:ed)?)\\b/iu" }
      ]
    },
    "us": {
      "note": "\"US officials\", \"US-led\": the country, written in capitals, unless the text around it is in capitals too.",
      "unless": [
        { "match": "/^US$/u", "before": "/^(?![\\s\\S]*[A-Z]{2,}\\s+$)/u", "after": "/^(?!\\s+[A-Z]{2,}\\b)/u" }
      ]
    },
    "wait": { "unless": [{ "after": "/^\\s+(?:times?|lists?|staff)\\b/iu" }] },
    "watch": {
      "note": "The noun, as in \"Watch brand Rolex\" or \"Watch list\".",
      "unless": [{ "after": "/^\\s+(?:brands?|makers?|straps?|faces?|dealers?|industry|company|sales|list|dog)\\b/iu" }]
    },
    "wild": {
      "unless": [
        { "before": "/\\b(?:the|into)\\s+$/iu" },
        { "after": "/^\\s*(?:(?:card|fire|life|animals?|horses?)\\b|['‘]n\\b)/iu" }
      ]
    }
  },
  "shared": {
    "quotedSpeech": {
      "note": "Words inside quotation marks that are still open are someone's speech, not the writer's voice.",
      "unless": [{ "openQuotes": "/[“‘'\"]/u" }]
    },
    "position": {
      "note": "Position words: \"far right corner\", \"pictured at far left\", \"(far right)\".",
      "unless": [
        { "after": "/^\\s*(?:corner|side|column|lane|edge|end|hand|wing of the (?:building|stage)|of (?:the|this) (?:photo|image|picture|screen|page|frame|row|stage|field)|in (?:the|this) (?:photo|image|picture))\\b/iu" },
        { "before": "/(?:\\(|\\b(?:pictured|seen|standing|seated|sits|sitting|from)\\b[^.]{0,20})\\s*$/iu", "after": "/^\\s*[),]/u" },
        { "before": "/\\((?:\\s*at)?\\s*$/iu" }
      ]
    },
    "productName": {
      "note": "Capitalized as part of a product or brand name: \"Xbox Elite 3 controller\", \"Marvel Legendary series\".",
      "unless": [
        { "match": "/^[\\p{Lu}\\d]/u", "nearby": "/\\b(?:xbox|playstation|pixel|iphone|galaxy|controller|gamepad|keyboard|mouse|laptop|phone|model|series|edition|package|trim|brand|product|album|film|show|team|unit|magazine|newspaper|records|studios)\\b/iu" },
        { "match": "/^[\\p{Lu}\\d]/u", "textBefore": "/\\b[A-Z][\\p{L}\\d-]+\\s+$/u" }
      ]
    }
  },
  "contexts": {
    "evaluative": {
      "note": "Keep this list politically mirrored: each side's pejorative \"elite\" modifiers count.",
      "when": [
        { "nearby": "/\\b(?:billionaire|coastal|conservative|corporate|corrupt|detached|entrenched|global|greedy|liberal|political|powerful|privileged|rich|ruling|urban|wealthy)\\b/iu" }
      ]
    }
  },
  "types": {
    "direct-address": {
      "note": "Ordinary in comments and on forums, so only publications; in body text only shown at \"Everything\".",
      "contexts": ["publication"],
      "unless": [{ "conversational": true }, "quotedSpeech"],
      "confidence": { "body": "contextual" }
    },
    "inclusive-pronoun": {
      "note": "Contextual everywhere: in headlines \"we\" is mostly the outlet (\"We tested ten beds\"), not an appeal to a shared side.",
      "contexts": ["publication"],
      "unless": [{ "conversational": true }, "quotedSpeech"]
    },
    "modality": {
      "contexts": ["publication"],
      "unless": [{ "conversational": true }, "quotedSpeech"],
      "confidence": { "body": "contextual" }
    },
    "imperative": {
      "note": "A capitalised command opens a sentence or follows a kicker (\"WATCH: ...\"). Not \"Check: £20\", \"Use of force\", \"Look-alike\", or a verb that has a subject after it.",
      "contexts": ["publication"],
      "only": [{ "match": "/^\\p{Lu}/u", "before": "/^\\s*$|[.!?|–—:]\\s+$/u" }],
      "unless": [
        { "conversational": true },
        "quotedSpeech",
        { "after": "/^(?:\\s*:|-|\\s+(?:of|is|are|was|were|has|have|had|will|says?|said)\\b)/iu" }
      ],
      "confidence": { "body": "contextual" }
    },
    "colloquialism": {
      "note": "Ordinary Reddit and YouTube language is not flagged.",
      "contexts": ["publication"]
    }
  }
}
